# Copy to .env for local development.
# On Netlify: Site settings → Environment variables (use your Render API URL).

# Local Django API
NEXT_PUBLIC_API_URL_1=http://127.0.0.1:8000/api/stroke/
NEXT_PUBLIC_API_URL_2=http://127.0.0.1:8000/api/hepatitis/
NEXT_PUBLIC_API_URL_3=http://127.0.0.1:8000/api/cancer/
NEXT_PUBLIC_RESOURCE_URL_1=http://127.0.0.1:8000/api/stroke/create/
NEXT_PUBLIC_RESOURCE_URL_2=http://127.0.0.1:8000/api/hepatitis/create/
NEXT_PUBLIC_RESOURCE_URL_3=http://127.0.0.1:8000/api/cancer/create/
NEXT_PUBLIC_API_URL_Token=http://127.0.0.1:8000/api/token/

# Production example (replace with your Render service URL):
# NEXT_PUBLIC_API_URL_1=https://wemedica-api.onrender.com/api/stroke/
# NEXT_PUBLIC_API_URL_2=https://wemedica-api.onrender.com/api/hepatitis/
# NEXT_PUBLIC_API_URL_3=https://wemedica-api.onrender.com/api/cancer/
# NEXT_PUBLIC_RESOURCE_URL_1=https://wemedica-api.onrender.com/api/stroke/create/
# NEXT_PUBLIC_RESOURCE_URL_2=https://wemedica-api.onrender.com/api/hepatitis/create/
# NEXT_PUBLIC_RESOURCE_URL_3=https://wemedica-api.onrender.com/api/cancer/create/
# NEXT_PUBLIC_API_URL_Token=https://wemedica-api.onrender.com/api/token/
